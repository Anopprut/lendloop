# --- Next.js (.env.local) ---
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Convex dashboard environment variables (Settings > Environment Variables) ---
# Clerk "Frontend API URL" (Clerk dashboard > API keys), e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS=you@example.com
# n8n production webhook URL, and the shared HMAC secret (same value in n8n's environment)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop-loan-event
N8N_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# --- n8n (.env next to docker-compose.yml) ---
LENDLOOP_WEBHOOK_SECRET=same-value-as-N8N_WEBHOOK_SECRET
# Convex HTTP actions base URL: https://your-deployment.convex.site  (note .site, not .cloud)
CONVEX_SITE_URL=https://your-deployment.convex.site
